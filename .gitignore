
# 🛡️ Sentinel OS v11.0 — Git Ignore Rules
# ============================================

# --- SECRETS ---
.env
.env.bank
.env.bak*
.env.old*
.env.backup*
.env.tmp*

# --- DOCKER & PERSISTENCE ---
persistence/
!persistence/.gitkeep

# --- LOGS & DIAGNOSTICS ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
diagnostic_*.txt

# --- BACKUPS (snapshots are local) ---
ops/backups/snapshots/

# --- OS SPECIFIC ---
.DS_Store
Thumbs.db
.history/
.vscode/
.idea/

# --- NODE (package.json is from Evolution API reference) ---
node_modules/
dist/
