# ╔════════════════════════════════════════════════════════════════════╗
# ║  CHATWOOT — Variables de Referencia Internas                      ║
# ║  Archivo de consulta. Los valores reales están en el .env raíz.   ║
# ╚════════════════════════════════════════════════════════════════════╝

# --- RUNTIME ---
NODE_ENV=production
RAILS_ENV=production
INSTALLATION_ENV=docker

# --- URL PÚBLICA (construida dinámicamente por docker-compose) ---
# FRONTEND_URL=https://chat.${DOMAIN}
# ↑ No se pone aquí, se inyecta en el docker-compose.yml

# --- SEGURIDAD ---
# SECRET_KEY_BASE → viene del .env raíz (openssl rand -hex 64)

# --- BASE DE DATOS ---
POSTGRES_DATABASE=chatwoot
POSTGRES_HOST=db_core
POSTGRES_USERNAME=chatwoot_user
# POSTGRES_PASSWORD → viene del .env raíz como ${CHATWOOT_DB_PASSWORD}

# --- REDIS ---
# REDIS_URL=redis://:${REDIS_PASSWORD}@cache_core:6379/1
# ↑ Index 1 para Chatwoot (Evolution usa Index 2)

# --- ALMACENAMIENTO S3 (MinIO) ---
ACTIVE_STORAGE_SERVICE=s3_compatible
# STORAGE_BUCKET_NAME → ${CHATWOOT_BUCKET} (default: chatwoot-storage)
# STORAGE_ACCESS_KEY_ID → ${MINIO_ROOT_USER}
# STORAGE_SECRET_ACCESS_KEY → ${MINIO_ROOT_PASSWORD}
# STORAGE_ENDPOINT → https://s3.${DOMAIN} (URL PÚBLICA, no interna)
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_REGION=us-east-1

# --- CORREO (desactivado por defecto) ---
MAILER_SENDER_EMAIL=Chatwoot <noreply@tu-dominio.com>
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=tu_api_key_sendgrid

# --- CONTROL DE REGISTROS ---
ENABLE_ACCOUNT_SIGNUP=false
ENABLE_USER_SIGNUP=false
