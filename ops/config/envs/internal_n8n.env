# ╔════════════════════════════════════════════════════════════════════╗
# ║  n8n — Variables de Referencia Internas                           ║
# ║  Motor de automatización v1.76.1                                  ║
# ╚════════════════════════════════════════════════════════════════════╝

# --- SERVIDOR ---
# N8N_HOST → n8n.${DOMAIN} (construido en docker-compose.yml)
N8N_PORT=5678
N8N_PROTOCOL=https
# WEBHOOK_URL → https://n8n.${DOMAIN}/ (construido en docker-compose.yml)

# --- SEGURIDAD ---
# N8N_ENCRYPTION_KEY → .env raíz (cifra credenciales guardadas en workflows)
N8N_BASIC_AUTH_ACTIVE=false

# --- BASE DE DATOS ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db_core
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
# DB_POSTGRESDB_PASSWORD → ${N8N_DB_PASSWORD} del .env raíz

# --- EJECUCIONES (Protocolo AEGIS) ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
EXECUTIONS_MODE=regular

# --- LOGS ---
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
