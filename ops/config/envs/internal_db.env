# ╔════════════════════════════════════════════════════════════════════╗
# ║  INFRAESTRUCTURA — Variables de Referencia Internas               ║
# ║  Postgres 16.6 | Redis 7.4 | MinIO                               ║
# ╚════════════════════════════════════════════════════════════════════╝

# --- POSTGRESQL ---
# Superusuario creado automáticamente al iniciar el contenedor
POSTGRES_USER=root_admin
# POSTGRES_PASSWORD → viene del .env raíz como ${POSTGRES_ROOT_PASSWORD}
POSTGRES_DB=postgres
PGDATA=/var/lib/postgresql/data

# Bases de datos creadas por 01-segregation.sh:
# ├── chatwoot    (usuario: chatwoot_user)
# ├── evolution   (usuario: evolution_user)
# └── n8n         (usuario: n8n_user)

# --- REDIS ---
# REDIS_PASSWORD → viene del .env raíz
ALLOW_EMPTY_PASSWORD=no
# Distribución de índices Redis:
# ├── Index 0: Reservado
# ├── Index 1: Chatwoot (Sidekiq + ActionCable)
# └── Index 2: Evolution API (Caché de sesiones)

# --- MINIO ---
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD → .env raíz
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# Acceso a consola web: http://localhost:9001
# Acceso API S3: http://localhost:9000 (o core_minio:9000 dentro de Docker)
