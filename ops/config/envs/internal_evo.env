# ╔════════════════════════════════════════════════════════════════════╗
# ║  EVOLUTION API v2.3.7 — Variables de Referencia Internas          ║
# ║  Gateway WhatsApp vía Baileys (multi-device)                      ║
# ║                                                                   ║
# ║  Este archivo documenta TODAS las variables disponibles.          ║
# ║  Solo las marcadas con ✅ están activas en el docker-compose.     ║
# ║  Las marcadas con ⬚ son opcionales y se activan aquí si se       ║
# ║  necesitan, luego se copian al .env raíz.                        ║
# ╚════════════════════════════════════════════════════════════════════╝

# ═══════════════════════ SERVIDOR ═══════════════════════
# ✅ SERVER_URL → https://api.${DOMAIN} (construido en docker-compose)
SERVER_PORT=8080
SERVER_TYPE=http
# ✅ AUTHENTICATION_API_KEY → ${EVOLUTION_API_KEY} del .env raíz
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ═══════════════════════ BASE DE DATOS ═══════════════════════
DATABASE_PROVIDER=postgresql
# ✅ DATABASE_CONNECTION_URI → construido en docker-compose con ${EVOLUTION_DB_PASSWORD}
DATABASE_CONNECTION_POOL_MAX=30
DATABASE_ENABLED=true
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# ═══════════════════════ CACHÉ REDIS ═══════════════════════
# ✅ CACHE_REDIS_URI → construido en docker-compose con ${REDIS_PASSWORD} (Index 2)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ═══════════════════════ S3 / MINIO ═══════════════════════
# ✅ Todas las variables S3 se definen en el docker-compose con valores del .env raíz
# S3_ENDPOINT=core_minio (hostname Docker interno)
# S3_BUCKET=${EVOLUTION_BUCKET} (default: evolution-media)

# ═══════════════════════ CHATWOOT INTEGRATION ═══════════════════════
# ✅ CHATWOOT_ENABLED=true (activado en docker-compose)
# ✅ CHATWOOT_URL → ${CHATWOOT_URL} del .env raíz (http://chatwoot-web:3000)
# ✅ CHATWOOT_TOKEN → ${CHATWOOT_GLOBAL_TOKEN} del .env raíz
CHATWOOT_MESSAGE_READ=true
CHATWOOT_MESSAGE_DELETE=true
CHATWOOT_BOT_CONTACT=true
# ✅ CHATWOOT_IMPORT_DATABASE_CONNECTION_URI → definido en .env [12]
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true

# ═══════════════════════ AUDIO CONVERTER ═══════════════════════
# ✅ API_AUDIO_CONVERTER=http://evolution_audio_converter:4040/process-audio
# ✅ API_AUDIO_CONVERTER_KEY → ${AUDIO_CONVERTER_KEY} del .env raíz

# ═══════════════════════ WHATSAPP CONFIG ═══════════════════════
# ✅ CONFIG_SESSION_PHONE_VERSION → del .env raíz
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# ═══════════════════════ LOGS ═══════════════════════
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS,WEBSOCKET
LOG_COLOR=true
LOG_BAILEYS=error

# ═══════════════════════ CORS ═══════════════════════
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# ═══════════════════════ EVENTOS Y WEBHOOKS ═══════════════════════
EVENT_EMITTER_MAX_LISTENERS=50
DEL_INSTANCE=false

# ⬚ WEBHOOK GLOBAL (desactivado — los webhooks se configuran por instancia)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300

# ⬚ RABBITMQ (desactivado)
RABBITMQ_ENABLED=false

# ⬚ SQS (desactivado)
SQS_ENABLED=false

# ⬚ WEBSOCKET (desactivado)
WEBSOCKET_ENABLED=false

# ⬚ PUSHER (desactivado)
PUSHER_ENABLED=false

# ⬚ KAFKA (desactivado)
KAFKA_ENABLED=false

# ⬚ TYPEBOT (desactivado)
TYPEBOT_ENABLED=false

# ⬚ OPENAI / DIFY / N8N / EVOAI (desactivados por defecto)
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false

# ⬚ WHATSAPP BUSINESS API (Cloud API, no Baileys)
WA_BUSINESS_TOKEN_WEBHOOK=evolution
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=en_US

# ⬚ TELEMETRÍA
TELEMETRY_ENABLED=false

# ⬚ PROMETHEUS
PROMETHEUS_METRICS=false

# ⬚ SENTRY
SENTRY_DSN=
