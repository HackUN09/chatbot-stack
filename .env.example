# 🤖 SENTINEL OS v11.0 - PLANTILLA DE CONFIGURACIÓN MAESTRA
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita tu .env con tus valores reales
# 3. Ejecuta: ./sistema_maestro.sh → Opción 1
# ============================================================
# ⚠️  NUNCA subas el archivo .env real a Git.
# ============================================================

# ============================================================
# [01] 🌐 DOMINIO Y TÚNEL CLOUDFLARE
# ============================================================
DOMAIN=tu-dominio.com
# Token de Cloudflare Zero Trust Tunnel.
# Obtener en: https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=tu_token_cloudflare_aqui

# ============================================================
# [02] 💬 CHATWOOT CRM
# ============================================================
CHATWOOT_ADMIN_EMAIL=admin@tu-dominio.com
CHATWOOT_ADMIN_PASSWORD=password_muy_seguro_chatwoot

# Generado automáticamente por sistema_maestro.sh → Opción 1
# NO tocar hasta que el sistema esté desplegado.
CHATWOOT_GLOBAL_TOKEN=SE_AUTOGENERA_AL_DESPLEGAR

CHATWOOT_ACCOUNT_ID=1
# URL INTERNA (DNS de Docker - NO cambiar)
CHATWOOT_URL=http://chatwoot-web:3000
FRONTEND_URL=https://chat.tu-dominio.com

# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=generar_con_openssl_rand_hex_64

# ============================================================
# [03] 🛠️ INFRAESTRUCTURA (POSTGRES / REDIS)
# ============================================================
POSTGRES_ROOT_PASSWORD=password_maestro_postgres
REDIS_PASSWORD=password_seguro_redis

# ============================================================
# [04] 🧬 BASE DE DATOS POR SERVICIO
# ============================================================
CHATWOOT_DB_PASSWORD=password_db_chatwoot
EVOLUTION_DB_PASSWORD=password_db_evolution
N8N_DB_PASSWORD=password_db_n8n

# ============================================================
# [05] 🔑 API KEYS Y SEGURIDAD
# ============================================================
EVOLUTION_API_KEY=tu_api_key_evolution_maestra
N8N_ENCRYPTION_KEY=clave_cifrado_n8n_32_caracteres
N8N_USER_MANAGEMENT_JWT_SECRET=secreto_jwt_n8n_seguro

# ============================================================
# [06] 📱 EVOLUTION API
# ============================================================
SERVER_URL=https://api.tu-dominio.com
DATABASE_CONNECTION_URI=postgresql://evolution_user:password_db_evolution@db_core:5432/evolution?schema=public
CACHE_REDIS_URI=redis://:password_seguro_redis@cache_core:6379/2
# Versión de WhatsApp Web emulada (mantener este valor)
CONFIG_SESSION_PHONE_VERSION=2.3000.1033351060

# ============================================================
# [07] 🪣 ALMACENAMIENTO S3 — MinIO
# ============================================================
# Credenciales de MinIO (administrador)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password_seguro_minio

# --- Configuración S3 para Evolution API ---
S3_ENABLED=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=password_seguro_minio
S3_REGION=us-east-1
S3_PORT=9000
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
# Bucket de medios de Evolution (imágenes, videos, stickers)
EVOLUTION_BUCKET=evolution-media

# Hostname interno de MinIO (NO cambiar)
S3_ENDPOINT=minio-core
S3_PORT=9000
# Bucket de adjuntos del CRM
CHATWOOT_BUCKET=chatwoot-storage
# URL CDN pública → lo que ve el navegador del agente
# (Debe ser el subdominio s3.tu-dominio.com enrutado en Cloudflare Tunnel)
STORAGE_CDN_HOST=https://s3.tu-dominio.com

# ============================================================
# [08] 👤 PANELES DE ADMINISTRACIÓN
# ============================================================
PGADMIN_DEFAULT_EMAIL=admin@tu-dominio.com
PGADMIN_DEFAULT_PASSWORD=password_pgadmin

# ============================================================
# [09] ⚙️ n8n AUTOMATION
# ============================================================
N8N_HOST=n8n.tu-dominio.com
WEBHOOK_URL=https://n8n.tu-dominio.com/

# ============================================================
# [10] 🛡️ AEGIS — GESTIÓN DE EJECUCIONES n8n
# ============================================================
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_PRUNE_TIMEOUT=3600
