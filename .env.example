# 🤖 SENTINEL OS v11.1 - PLANTILLA DE CONFIGURACIÓN MAESTRA (MULTIMEDIA READY)
# ========================================================
# Copia este archivo a .env y rellena tus datos reales.
# Todos los servicios están orquestados para comunicarse
# mediante la red interna 'secure-net' de Docker.
# ========================================================

# [01] 🌐 DOMINIO Y TÚNEL ---------------------------------
DOMAIN=tu-dominio.com
CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui

# [02] 💬 CHATWOOT CRM ------------------------------------
# Credenciales del Administrador Inicial
CHATWOOT_ADMIN_EMAIL=admin@tu-dominio.com
CHATWOOT_ADMIN_PASSWORD=password_seguro_chatwoot

# Seguridad y Base de Datos
SECRET_KEY_BASE=generar_con_openssl_rand_hex_64
CHATWOOT_DB_PASSWORD=password_db_chatwoot
# Host: db_core (DNS interno)
# REDIS_URL: database 1 para Chatwoot
REDIS_URL=redis://:password_seguro_redis@cache_core:6379/1

# Integración Inbound (Para que Evolution le hable a Chatwoot)
# Usa el DNS interno 'chatwoot' ya que están en la misma red
CHATWOOT_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_GLOBAL_TOKEN=tu_global_token_chatwoot

# [03] 📱 EVOLUTION API -----------------------------------
EVOLUTION_API_KEY=tu_api_key_maestra
EVOLUTION_DB_PASSWORD=password_db_evolution
# REDIS_URL: database 2 para Evolution
CACHE_REDIS_URI=redis://:password_seguro_redis@cache_core:6379/2
# Versión de WhatsApp para consistencia (Multimeia/Stickers support)
CONFIG_SESSION_PHONE_VERSION=2.3000.1033351060

# [04] ⚙️ n8n AUTOMATION ----------------------------------
N8N_ENCRYPTION_KEY=tu_key_de_cifrado_n8n
N8N_DB_PASSWORD=password_db_n8n
# n8n usa DB n8n en el host db_core

# [05] 🛠️ INFRAESTRUCTURA (POSTGRES / REDIS) --------------
POSTGRES_ROOT_PASSWORD=password_maestro_db
REDIS_PASSWORD=password_seguro_redis

# [06] 🪣 ALMACENAMIENTO S3 (MINIO) -----------------------
# Estas credenciales dan acceso a PDF, Imágenes, Videos y Stickers
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password_seguro_minio

# S3 Common Settings (Usa 'core_minio' para comunicación interna)
S3_REGION=us-east-1
S3_PORT=9000
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# Bucket Names (Asegúrate de crearlos en el panel de MinIO)
S3_BUCKET_EVOLUTION=evolution-media
S3_BUCKET_CHATWOOT=chatwoot-storage

# Chatwoot S3 Config (Para ver multimedia en el CRM)
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=password_seguro_minio
STORAGE_BUCKET_NAME=chatwoot-storage
STORAGE_ENDPOINT=http://core_minio:9000
STORAGE_REGION=us-east-1

# [07] 👤 ADMINISTRACIÓN Y PANELES ------------------------
PGADMIN_DEFAULT_EMAIL=admin@tu-dominio.com
PGADMIN_DEFAULT_PASSWORD=password_seguro_pgadmin

# [08] 🛡️ AEGIS PRUNING (LIMPIEZA AUTOMÁTICA) -------------
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_PRUNE_TIMEOUT=3600
