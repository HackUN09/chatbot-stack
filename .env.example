# 🤖 SENTINEL OS v11.1 - CONFIGURATION MASTER (Cleaned)
# ========================================================

# [01] 🌐 DOMAIN & TUNNEL
# ★ Domain without https:// (e.g., yourcompany.com)
DOMAIN=tuempresa.com

# ★ Cloudflare Zero Trust Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# [02] 💬 CHATWOOT & INTEGRATION
CHATWOOT_ADMIN_EMAIL=admin@tuempresa.com
CHATWOOT_ADMIN_PASSWORD=TuPasswordSegura123!

# [03] 🛠️ INFRA CORE
# Master DB password (used for postgres root)
POSTGRES_ROOT_PASSWORD=HackUN1991.1
REDIS_PASSWORD=HackUN1991.1

# [04] 🧬 DB PASSWORDS (Segregated)
CHATWOOT_DB_PASSWORD=HackUN1991.1
EVOLUTION_DB_PASSWORD=HackUN1991.1
N8N_DB_PASSWORD=HackUN1991.1

# [05] 🔑 API KEYS & ENCRYPTION
EVOLUTION_API_KEY=HackUN1991.1
N8N_ENCRYPTION_KEY=N8N_ENCRYPTION_KEY_32_CHARS_MIN
N8N_USER_MANAGEMENT_JWT_SECRET=JWT_SECRET_RANDOM_STRING

# [06] 📱 EVOLUTION API CONFIG
SERVER_URL=https://api.${DOMAIN}
DATABASE_CONNECTION_URI=postgresql://evolution_user:${EVOLUTION_DB_PASSWORD}@db_core:5432/evolution?schema=public
CACHE_REDIS_URI=redis://:${REDIS_PASSWORD}@cache_core:6379/2
CONFIG_SESSION_PHONE_VERSION=2.3000.1033351060

# [07] 🎤 AUDIO CONVERTER
API_AUDIO_CONVERTER=http://evolution_audio_converter:4040/process-audio
AUDIO_CONVERTER_ENABLED=true
AUDIO_CONVERTER_KEY=HackUN1991.1
WA_BUSINESS_AUDIO_CHANNEL=true
EVOLUTION_AUDIO_CONVERTER_FORCE=true

# [08] 🪣 STORAGE (S3 COMPATIBLE)
S3_ENABLED=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=HackUN1991.1
S3_ENDPOINT=core_minio
S3_PORT=9000
S3_REGION=us-east-1
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
# Public URL for Chatwoot SSRF bypassing
S3_PUBLIC_URL=https://s3.${DOMAIN}

# Buckets
EVOLUTION_BUCKET=evolution-media
CHATWOOT_BUCKET=chatwoot-storage

# Chatwoot S3 config
STORAGE_ENDPOINT=http://core_minio:9000
STORAGE_CDN_HOST=https://s3.${DOMAIN}

# [09] 👥 ADMIN PANELS
PGADMIN_DEFAULT_EMAIL=admin@${DOMAIN}
PGADMIN_DEFAULT_PASSWORD=HackUN1991.1

# [10] ⚙️ n8n ENGINE
N8N_HOST=n8n.${DOMAIN}
WEBHOOK_URL=https://n8n.${DOMAIN}/

# [11] 🛡️ AEGIS PROTOCOL (Auto-Prune)
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_PRUNE_TIMEOUT=3600

# [12] 🔗 IMPORT DB URI
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=postgresql://chatwoot_user:${CHATWOOT_DB_PASSWORD}@db_core:5432/chatwoot
