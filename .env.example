# ╔════════════════════════════════════════════════════════════════════╗
# ║  🤖 SENTINEL OS v11.0 — PLANTILLA MAESTRA DE CONFIGURACIÓN       ║
# ╠════════════════════════════════════════════════════════════════════╣
# ║  INSTRUCCIONES:                                                   ║
# ║  1. Copia este archivo:  cp .env.example .env                    ║
# ║  2. Edita tu .env con tus valores reales (ver comentarios abajo) ║
# ║  3. Ejecuta: ./sistema_maestro.sh → Opción 1 (Genesis)          ║
# ║                                                                   ║
# ║  ⚠️  NUNCA subas el archivo .env real a Git.                      ║
# ║  📖 Cada variable está documentada con su origen y propósito.     ║
# ╚════════════════════════════════════════════════════════════════════╝

# ┌──────────────────────────────────────────────────────────────┐
# │ [01] 🌐 DOMINIO Y TÚNEL CLOUDFLARE                          │
# │ Uso: Todos los servicios construyen sus URLs con ${DOMAIN}  │
# │ Ejemplo: chat.${DOMAIN}, api.${DOMAIN}, n8n.${DOMAIN}      │
# └──────────────────────────────────────────────────────────────┘
DOMAIN=tu-dominio.com
# Token de Cloudflare Zero Trust Tunnel.
# Obtener en: https://one.dash.cloudflare.com → Networks → Tunnels → Create
# Formato: eyJhIjoiMD... (cadena Base64 larga)
CLOUDFLARE_TUNNEL_TOKEN=tu_token_cloudflare_aqui

# ┌──────────────────────────────────────────────────────────────┐
# │ [02] 💬 CHATWOOT CRM                                        │
# │ Servicios: chatwoot-web, chatwoot-worker                    │
# └──────────────────────────────────────────────────────────────┘
# Email y password del primer administrador (se crea automáticamente)
CHATWOOT_ADMIN_EMAIL=admin@tu-dominio.com
CHATWOOT_ADMIN_PASSWORD=CambiaEstaPassword123!
# Token API del admin — se inyecta automáticamente por sistema_maestro.sh
# NO tocar manualmente hasta que el sistema esté desplegado.
CHATWOOT_GLOBAL_TOKEN=SE_AUTOGENERA_AL_DESPLEGAR
# ID de cuenta en Chatwoot (siempre 1 para la primera instalación)
CHATWOOT_ACCOUNT_ID=1
# URL INTERNA de Chatwoot (Docker DNS). NO cambiar este valor jamás.
CHATWOOT_URL=http://chatwoot-web:3000
# URL PÚBLICA del frontend (la que ven los agentes humanos en el navegador)
FRONTEND_URL=https://chat.tu-dominio.com
# Clave criptográfica de Rails. Generar con: openssl rand -hex 64
# CRÍTICO: si cambias esta clave, pierdes todas las sesiones activas.
SECRET_KEY_BASE=GENERA_CON_openssl_rand_hex_64

# ┌──────────────────────────────────────────────────────────────┐
# │ [03] 🛠️ INFRAESTRUCTURA CORE                                │
# │ Servicios: db_core (Postgres), cache_core (Redis)           │
# └──────────────────────────────────────────────────────────────┘
# Password del superusuario 'root_admin' de PostgreSQL
POSTGRES_ROOT_PASSWORD=CambiaEstaPasswordDB!
# Password de Redis (usada por Chatwoot y Evolution como caché/cola)
REDIS_PASSWORD=CambiaEstaPasswordRedis!

# ┌──────────────────────────────────────────────────────────────┐
# │ [04] 🧬 CONTRASEÑAS DE BASE DE DATOS POR SERVICIO           │
# │ Cada servicio tiene su propio usuario y contraseña en       │
# │ PostgreSQL, creados automáticamente por 01-segregation.sh   │
# └──────────────────────────────────────────────────────────────┘
CHATWOOT_DB_PASSWORD=CambiaPasswordChatwootDB!
EVOLUTION_DB_PASSWORD=CambiaPasswordEvolutionDB!
N8N_DB_PASSWORD=CambiaPasswordN8nDB!

# ┌──────────────────────────────────────────────────────────────┐
# │ [05] 🔑 API KEYS Y CIFRADO                                  │
# │ Estas claves protegen las APIs expuestas y los datos        │
# └──────────────────────────────────────────────────────────────┘
# API Key maestra para autenticarse en Evolution API (Header: apikey)
EVOLUTION_API_KEY=CambiaEstaApiKeyEvolution!
# Clave de cifrado de n8n (protege credenciales guardadas en workflows)
N8N_ENCRYPTION_KEY=CambiaClaveCifradoN8n32chars!
# JWT Secret de n8n (autenticación de usuarios en el editor)
N8N_USER_MANAGEMENT_JWT_SECRET=CambiaSecretoJwtN8n!

# ┌──────────────────────────────────────────────────────────────┐
# │ [06] 📱 EVOLUTION API — WhatsApp Gateway                    │
# │ Servicio: app_evolution                                     │
# └──────────────────────────────────────────────────────────────┘
# URL PÚBLICA de Evolution API (visible desde el administrador web)
SERVER_URL=https://api.tu-dominio.com
# URI de conexión a PostgreSQL para Evolution (usa el usuario evolution_user)
# ⚠️ La contraseña aquí DEBE coincidir con EVOLUTION_DB_PASSWORD
DATABASE_CONNECTION_URI=postgresql://evolution_user:CambiaPasswordEvolutionDB!@db_core:5432/evolution?schema=public
# URI de Redis para caché de sesiones de Evolution (usa DB index 2)
# ⚠️ La contraseña aquí DEBE coincidir con REDIS_PASSWORD
CACHE_REDIS_URI=redis://:CambiaEstaPasswordRedis!@cache_core:6379/2
# Versión de WhatsApp Web emulada por Baileys (no cambiar sin verificar compatibilidad)
CONFIG_SESSION_PHONE_VERSION=2.3000.1033351060

# ┌──────────────────────────────────────────────────────────────┐
# │ [07] 🎤 AUDIO & VIDEO TRANSCODING (OMNI-PRO)                │
# │ Servicio: evolution_audio_converter                         │
# │ Resuelve: audios .opus de WhatsApp que no suenan en browser │
# └──────────────────────────────────────────────────────────────┘
# Activar el microservicio de transcodificación de audio
AUDIO_CONVERTER_ENABLED=true
# Canal de audio compatible para WhatsApp Business
WA_BUSINESS_AUDIO_CHANNEL=true
# URL del convertidor (DNS INTERNO de Docker — NO cambiar)
API_AUDIO_CONVERTER=http://evolution_audio_converter:4040/process-audio
# Forzar transcoding incluso si el formato original parece correcto (recomendado)
EVOLUTION_AUDIO_CONVERTER_FORCE=true
# Clave de autenticación del servicio de audio
AUDIO_CONVERTER_KEY=CambiaClaveAudioConverter!

# ┌──────────────────────────────────────────────────────────────┐
# │ [08] 🪣 ALMACENAMIENTO S3 — MinIO                           │
# │ Servicio: core_minio                                        │
# │ Buckets: evolution-media (multimedia WhatsApp)               │
# │          chatwoot-storage (adjuntos del CRM)                │
# └──────────────────────────────────────────────────────────────┘
# Credenciales de acceso a MinIO (también usadas para S3 por Evolution y Chatwoot)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CambiaEstaPasswordMinio!
# Activar almacenamiento S3 en Evolution API
S3_ENABLED=true
# Credenciales S3 de Evolution (deben coincidir con MINIO_ROOT_USER/PASSWORD)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CambiaEstaPasswordMinio!
# Región S3 (MinIO la ignora, pero es requerida por el SDK)
S3_REGION=us-east-1
# Puerto interno de MinIO (no cambiar)
S3_PORT=9000
# Hostname INTERNO de MinIO en Docker (nombre del servicio = core_minio)
# ⚠️ CRÍTICO: debe ser 'core_minio', NO 'minio-core' ni 'localhost'
S3_ENDPOINT=core_minio
# Formato de URL tipo path (requerido por MinIO)
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
# Nombre del bucket de multimedia de Evolution
EVOLUTION_BUCKET=evolution-media
# Nombre del bucket de adjuntos de Chatwoot
CHATWOOT_BUCKET=chatwoot-storage
# URL CDN PÚBLICA de MinIO (la que ve el navegador del agente humano)
# Debe ser el subdominio s3.tu-dominio.com configurado en Cloudflare Tunnel
STORAGE_CDN_HOST=https://s3.tu-dominio.com

# ┌──────────────────────────────────────────────────────────────┐
# │ [09] 👤 PANELES DE ADMINISTRACIÓN                           │
# │ Servicios: pgadmin (localhost:5050), redis-insight (:5540)  │
# └──────────────────────────────────────────────────────────────┘
PGADMIN_DEFAULT_EMAIL=admin@tu-dominio.com
PGADMIN_DEFAULT_PASSWORD=CambiaPasswordPgAdmin!

# ┌──────────────────────────────────────────────────────────────┐
# │ [10] ⚙️ n8n — MOTOR DE AUTOMATIZACIÓN                       │
# │ Servicio: app_n8n_editor                                    │
# └──────────────────────────────────────────────────────────────┘
# Hostname público de n8n (usado por el editor web)
N8N_HOST=n8n.tu-dominio.com
# URL base para los webhooks de n8n (usada por workflows que reciben llamadas)
WEBHOOK_URL=https://n8n.tu-dominio.com/

# ┌──────────────────────────────────────────────────────────────┐
# │ [11] 🛡️ AEGIS — GESTIÓN DE EJECUCIONES n8n                  │
# │ Auto-poda de ejecuciones antiguas para no llenar el disco   │
# └──────────────────────────────────────────────────────────────┘
# Máximo de horas que se guardan los registros de ejecuciones (168h = 7 días)
N8N_EXECUTIONS_DATA_MAX_AGE=168
# Activar poda automática
N8N_EXECUTIONS_DATA_PRUNE=true
# Timeout del proceso de poda en segundos
N8N_EXECUTIONS_DATA_PRUNE_TIMEOUT=3600

# ┌──────────────────────────────────────────────────────────────┐
# │ [12] 🔗 CHATWOOT ↔ EVOLUTION — Importación de Mensajes      │
# │ URI para que Evolution importe historial directamente       │
# │ ⚠️ La contraseña DEBE coincidir con CHATWOOT_DB_PASSWORD    │
# └──────────────────────────────────────────────────────────────┘
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=postgresql://chatwoot_user:CambiaPasswordChatwootDB!@db_core:5432/chatwoot?sslmode=disable
